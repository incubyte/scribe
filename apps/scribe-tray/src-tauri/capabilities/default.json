{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets Scribe open its transcripts folder, run the privacy statement window and drive the popover",
  "windows": [
    "privacy",
    "idle-notice",
    "region-selector",
    "popover"
  ],
  "permissions": [
    "store:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOCUMENT/Scribe/**"
        },
        {
          "path": "$DOCUMENT/Scribe"
        }
      ]
    }
  ]
}
