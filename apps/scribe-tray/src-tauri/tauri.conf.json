{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe",
  "version": "0.4.1",
  "identifier": "com.incubyte.scribe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "bash scripts/stage-sidecar.sh && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html#popover",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover", "mica"],
          "state": "active",
          "radius": 12
        },
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "width": 360,
        "height": 440
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/scribe-mcp"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4NjlBQzE3MzNDMzFEMjcKUldRbkhjTXpGNnhwQ0tUMlBPOWl4bDdyUndLd3dNU0VKWXVNTEw3YTlSR2J1OW8raGQ4QzJrUnEK",
      "endpoints": [
        "https://github.com/incubyte/scribe/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
